package com.bootexample4.products.controller;import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

public class ProductControllerGetAllProductsTest {
    @Mock
    private ProductRepository productRepository;
    private ProductController productController;
    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
        productController = new ProductController();
        productController.setProductRepository(productRepository); // Setting repository as the business logic expects it.
    }
    @Test
    @Tag("valid")
    public void returnsNonEmptyListWhenRepositoryHasProducts() {
        // Arrange
        List<Product> sampleProducts = new ArrayList<>();
        Product product1 = new Product(); // Updated instantiation to match the zero-argument constructor
        product1.setId(1L);
        product1.setName("Product 1");
        product1.setDescription("Description 1");
        product1.setPrice(10.0);
        Product product2 = new Product(); // Updated instantiation to match the zero-argument constructor
        product2.setId(2L);
        product2.setName("Product 2");
        product2.setDescription("Description 2");
        product2.setPrice(20.0);
        sampleProducts.add(product1);
        sampleProducts.add(product2);
        when(productRepository.findAll()).thenReturn(sampleProducts);
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertEquals(sampleProducts.size(), result.size());
        assertEquals(sampleProducts, result);
    }
    @Test
    @Tag("valid")
    public void returnsEmptyListWhenRepositoryIsEmpty() {
        // Arrange
        when(productRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertTrue(result.isEmpty());
    }
    @Test
    @Tag("invalid")
    public void handlesNullReturnFromRepository() {
        // Arrange
        when(productRepository.findAll()).thenReturn(null);
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertNotNull(result);
        assertTrue(result.isEmpty());
    }
    @Test
    @Tag("boundary")
    public void callsRepositoryOnceForFetchingProducts() {
        // Arrange
        when(productRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        productController.getAllProducts();
        // Assert
        verify(productRepository, times(1)).findAll();
    }
    @Test
    @Tag("invalid")
    public void handlesRepositoryExceptionsGracefully() {
        // Arrange
        when(productRepository.findAll()).thenThrow(new RuntimeException("Database error"));
        // Act & Assert
        try {
            productController.getAllProducts();
            fail("RuntimeException expected, but not thrown");
        } catch (RuntimeException e) {
            assertEquals("Database error", e.getMessage());
        }
    }
    @Test
    @Tag("invalid")
    public void failsWhenRepositoryIsNull() {
        // Arrange
        ProductController controllerWithNullRepo = new ProductController();
        controllerWithNullRepo.setProductRepository(null); // Setting repository explicitly to null
        // Act & Assert
        try {
            controllerWithNullRepo.getAllProducts();
            fail("NullPointerException or similar expected, but not thrown");
        } catch (Exception e) {
            assertNotNull(e);
        }
    }
    @Test
    @Tag("boundary")
    public void returnsCorrectTypeForResult() {
        // Arrange
        List<Product> sampleProducts = new ArrayList<>();
        Product product = new Product(); // Updated instantiation to match the zero-argument constructor
        product.setId(1L);
        product.setName("Product 1");
        product.setDescription("Description 1");
        product.setPrice(10.0);
        sampleProducts.add(product);
        when(productRepository.findAll()).thenReturn(sampleProducts);
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertTrue(result instanceof List);
    }
    @Test
    @Tag("integration")
    public void producesPredictableOutputBasedOnRepositoryState() {
        // Non-empty repository
        List<Product> sampleProducts = new ArrayList<>();
        Product product = new Product(); // Updated instantiation to match the zero-argument constructor
        product.setId(1L);
        product.setName("Product 1");
        product.setDescription("Description 1");
        product.setPrice(10.0);
        sampleProducts.add(product);
        when(productRepository.findAll()).thenReturn(sampleProducts);
        List<Product> resultNonEmpty = productController.getAllProducts();
        assertFalse(resultNonEmpty.isEmpty());
        assertEquals(sampleProducts, resultNonEmpty);
        // Empty repository
        when(productRepository.findAll()).thenReturn(new ArrayList<>());
        List<Product> resultEmpty = productController.getAllProducts();
        assertTrue(resultEmpty.isEmpty());
        // Null repository
        when(productRepository.findAll()).thenReturn(null);
        List<Product> resultNull = productController.getAllProducts();
        assertNotNull(resultNull);
        assertTrue(resultNull.isEmpty());
    }
}