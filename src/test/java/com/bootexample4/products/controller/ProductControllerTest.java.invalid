@Test
@Tag("valid")
public void createProduct_doesNotAlterInputData() {
    
    Product validProduct = new Product();
    validProduct.setName("Sample Product");
    validProduct.setDescription("Sample Description");
    validProduct.setPrice(100.0);
    when(productRepository.save(validProduct)).thenReturn(validProduct);
    Product createdProduct = productController.createProduct(validProduct);
    assertEquals(validProduct.getName(), createdProduct.getName(), "Name should not be altered");
    assertEquals(validProduct.getDescription(), createdProduct.getDescription(), "Description should not be altered");
    assertEquals(validProduct.getPrice(), createdProduct.getPrice(), "Price should not be altered");
    verify(productRepository, times(1)).save(validProduct);
}

