@Test
@Tag("integration")
public void checkHttpResponseStatus() {
    
    Product existingProduct = new Product();
    existingProduct.setId(1L);
    existingProduct.setName("Product A");
    existingProduct.setDescription("Description A");
    existingProduct.setPrice(100.0);
    
    Product updatedProduct = new Product();
    updatedProduct.setId(1L);
    updatedProduct.setName("Updated Product");
    updatedProduct.setDescription("Updated Description");
    updatedProduct.setPrice(200.0);
    when(productRepository.findById(1L)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(any(Product.class))).thenReturn(updatedProduct);
    ResponseEntity<Product> successResponse = productController.updateProduct(1L, updatedProduct);
    assertEquals(200, successResponse.getStatusCodeValue());
    when(productRepository.findById(999L)).thenReturn(Optional.empty());
    ResponseEntity<Product> failureResponse = productController.updateProduct(999L, updatedProduct);
    assertEquals(404, failureResponse.getStatusCodeValue());
}

