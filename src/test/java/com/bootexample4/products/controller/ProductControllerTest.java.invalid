@Test
@Tag("boundary")
public void returnsCorrectTypeForResult() {
    
    List<Product> sampleProducts = new ArrayList<>();
    Product product = new Product();
    product.setId(1L);
    product.setName("Product 1");
    product.setDescription("Description 1");
    product.setPrice(10.0);
    sampleProducts.add(product);
    when(productRepository.findAll()).thenReturn(sampleProducts);
    
    List<Product> result = productController.getAllProducts();
    
    assertTrue(result instanceof List);
}

/*ROOST_METHOD_HASH=getAllProducts_7e38cc05f6
ROOST_METHOD_SIG_HASH=getAllProducts_fef141838b

*/
@Test
@Tag("integration")
public void producesPredictableOutputBasedOnRepositoryState() {
    
    List<Product> sampleProducts = new ArrayList<>();
    Product product = new Product();
    product.setId(1L);
    product.setName("Product 1");
    product.setDescription("Description 1");
    product.setPrice(10.0);
    sampleProducts.add(product);
    when(productRepository.findAll()).thenReturn(sampleProducts);
    List<Product> resultNonEmpty = productController.getAllProducts();
    assertFalse(resultNonEmpty.isEmpty());
    assertEquals(sampleProducts, resultNonEmpty);
    
    when(productRepository.findAll()).thenReturn(new ArrayList<>());
    List<Product> resultEmpty = productController.getAllProducts();
    assertTrue(resultEmpty.isEmpty());
    
    when(productRepository.findAll()).thenReturn(null);
    List<Product> resultNull = productController.getAllProducts();
    assertNotNull(resultNull);
    assertTrue(resultNull.isEmpty());
}
}