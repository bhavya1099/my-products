@Test
@Tag("boundary")
public void handleConcurrentUpdates() {
    
    Product existingProduct = new Product();
    existingProduct.setId(1L);
    existingProduct.setName("Product A");
    existingProduct.setDescription("Description A");
    existingProduct.setPrice(100.0);
    
    Product updatedProduct1 = new Product();
    updatedProduct1.setId(1L);
    updatedProduct1.setName("Updated Product A1");
    updatedProduct1.setDescription("Updated Description A1");
    updatedProduct1.setPrice(150.0);
    
    Product updatedProduct2 = new Product();
    updatedProduct2.setId(1L);
    updatedProduct2.setName("Updated Product A2");
    updatedProduct2.setDescription("Updated Description A2");
    updatedProduct2.setPrice(200.0);
    when(productRepository.findById(1L)).thenReturn(Optional.of(existingProduct));
    
    ResponseEntity<Product> response1 = productController.updateProduct(1L, updatedProduct1);
    ResponseEntity<Product> response2 = productController.updateProduct(1L, updatedProduct2);
    
    verify(productRepository, times(2)).save(any(Product.class));
}

