@Test
@Tag("boundary")
public void createProduct_validatesPriceBoundaryValues() {
    
    Product lowPriceProduct = new Product();
    lowPriceProduct.setName("Low Price Product");
    lowPriceProduct.setDescription("Sample Description");
    lowPriceProduct.setPrice(0.0);
    
    Product highPriceProduct = new Product();
    highPriceProduct.setName("High Price Product");
    highPriceProduct.setDescription("Sample Description");
    highPriceProduct.setPrice(Double.MAX_VALUE);
    
    Product negativePriceProduct = new Product();
    negativePriceProduct.setName("Negative Price Product");
    negativePriceProduct.setDescription("Sample Description");
    negativePriceProduct.setPrice(-10.0);
    when(productRepository.save(lowPriceProduct)).thenReturn(lowPriceProduct);
    when(productRepository.save(highPriceProduct)).thenReturn(highPriceProduct);
    assertDoesNotThrow(() -> productController.createProduct(lowPriceProduct), "Should allow price value of 0");
    assertDoesNotThrow(() -> productController.createProduct(highPriceProduct), "Should allow large price values");
    assertThrows(IllegalArgumentException.class, () -> productController.createProduct(negativePriceProduct), "Should throw exception for negative prices");
    verify(productRepository, times(1)).save(lowPriceProduct);
    verify(productRepository, times(1)).save(highPriceProduct);
    verify(productRepository, never()).save(negativePriceProduct);
}

