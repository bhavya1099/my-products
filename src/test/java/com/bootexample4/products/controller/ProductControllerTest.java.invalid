@Test
@Tag("invalid")
public void failsWhenRepositoryIsNull() {
    
    ProductController controllerWithNullRepo = new ProductController();
    controllerWithNullRepo.setProductRepository(null);
    
    try {
        controllerWithNullRepo.getAllProducts();
        fail("NullPointerException or similar expected, but not thrown");
    } catch (Exception e) {
        assertNotNull(e);
    }
}

