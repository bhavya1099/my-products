@Test
@Tag("valid")
public void verifySuccessfulProductUpdate() {
    
    Product existingProduct = new Product();
    existingProduct.setId(1L);
    existingProduct.setName("Product A");
    existingProduct.setDescription("Description A");
    existingProduct.setPrice(100.0);
    
    Product updatedProduct = new Product();
    updatedProduct.setId(1L);
    updatedProduct.setName("Updated Product A");
    updatedProduct.setDescription("Updated Description A");
    updatedProduct.setPrice(150.0);
    when(productRepository.findById(1L)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(any(Product.class))).thenReturn(updatedProduct);
    ResponseEntity<Product> response = productController.updateProduct(1L, updatedProduct);
    assertEquals(200, response.getStatusCodeValue());
    assertEquals("Updated Product A", response.getBody().getName());
    assertEquals("Updated Description A", response.getBody().getDescription());
    
    assertEquals(150.0, response.getBody().getPrice(), 0.001);
    verify(productRepository).save(any(Product.class));
}

